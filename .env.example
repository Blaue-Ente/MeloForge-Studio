APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_MODE=hybrid
MAX_TASK_BUDGET_USD=2.00
ALLOW_CLOUD_FALLBACK=true

# Local LLM via Ollama
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_MIN_FREE_RAM_GB=5

# Cloud LLM keys — keep them server-side
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_INPUT_USD_PER_1M=0
OPENROUTER_OUTPUT_USD_PER_1M=0

NOVITA_API_KEY=
NOVITA_MODEL=
NOVITA_INPUT_USD_PER_1M=0
NOVITA_OUTPUT_USD_PER_1M=0

NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_INPUT_USD_PER_1M=0
NVIDIA_OUTPUT_USD_PER_1M=0

HF_TOKEN=
HF_MODEL=
HF_INPUT_USD_PER_1M=0
HF_OUTPUT_USD_PER_1M=0

# Video (Novita Wan 2.2 T2V)
NOVITA_VIDEO_COST_PER_SECOND_USD=0
NOVITA_VIDEO_MAX_SECONDS=8
PRIMARY_CLOUD_PROVIDER=openrouter

# Music generation (ACE-Step 1.5 asynchronous API). Run locally or use your
# own private endpoint. Local generation has no per-API charge.
ACE_STEP_ENABLED=false
ACE_STEP_BASE_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_MODEL=acestep-v15-turbo
ACE_STEP_COST_PER_SECOND_USD=0
# true only if ACE-Step was started with its 5Hz LM (ACESTEP_INIT_LLM=true, ~6 GB+ VRAM).
# Without it, write lyrics yourself or use "Write lyrics with AI" (Ollama/cloud LLM).
ACE_STEP_LM_ENABLED=false
